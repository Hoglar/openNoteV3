# Copy to .env.production in the repository root and chmod 600.
# Never use development OAuth credentials or commit the resulting file.
SITE_DOMAIN=notes.example.com
# Same tag for both images, e.g. the full Git commit ID. Do not reuse a tag.
OPENNOTE_RELEASE=
# Generate three independent values: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
