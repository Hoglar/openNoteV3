# Local development only. Copy to .env; never commit .env.
DJANGO_ENV=local
DJANGO_DEBUG=false
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=opennote
POSTGRES_USER=opennote
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional until you register OAuth applications. Both values are required per provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
